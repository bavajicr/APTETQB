<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>APTET Paper 2A – Full Mock Test 02</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Telugu:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#0b2447;--navy2:#19376d;--teal:#0e9aa7;--tealbg:#e3f6f7;--blue:#1d4ed8;--bluebg:#dbe7ff;--purple:#7e3ff2;--purplebg:#efe5ff;--bg:#f3f5f9;--card:#fff;--tx:#18212f;--mut:#5b6678;--line:#d3dae6;--amber:#d97706}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--tx);font-family:'Inter','Noto Sans Telugu',system-ui,sans-serif;font-size:15px}
body,.noselect{-webkit-user-select:none;-moz-user-select:none;user-select:none;-webkit-touch-callout:none}
input{-webkit-user-select:text;user-select:text}
.hidden{display:none!important}
.wrap{max-width:1180px;margin:0 auto;padding:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px}
.btn{border:1px solid transparent;border-radius:8px;padding:10px 16px;font:600 14px 'Inter',sans-serif;cursor:pointer;color:#fff;background:var(--teal)}
.btn.sec{background:#fff;color:var(--navy);border-color:var(--line)}
.btn.navy{background:var(--navy)}.btn.rev{background:var(--purple)}.btn.warn{background:var(--amber)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.credit{text-align:center;font-size:12px;color:var(--mut);padding:12px 6px;line-height:1.55}
.credit b{color:var(--navy)}.credit a{color:var(--blue);font-weight:600;text-decoration:none}
/* start */
.hero{background:var(--navy);color:#fff;border-radius:10px;padding:20px 16px;text-align:center;border-bottom:4px solid var(--teal)}
.hero h1{margin:0;font-size:20px;letter-spacing:.2px}.hero h2{margin:4px 0 0;font-size:13px;font-weight:500;color:#9be4ea;letter-spacing:1.5px}
.hero p{margin:10px 0 0;font-size:12.5px;opacity:.85}
label{display:block;font-weight:600;font-size:13px;margin:14px 0 4px}
input[type=text]{width:100%;padding:12px;border:1.5px solid var(--line);border-radius:8px;font:15px 'Inter','Noto Sans Telugu',sans-serif;background:#fff}
input[type=text]:focus{outline:0;border-color:var(--teal)}
.err{color:#b42318;font-size:13px;margin-top:8px;min-height:18px;font-weight:600}
.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:12px 0}
.facts div{background:var(--tealbg);border-radius:8px;padding:9px 6px;text-align:center;font-size:12px;color:var(--mut)}.facts b{display:block;font-size:16px;color:var(--navy)}
.instr{font-size:13px;line-height:1.7;color:#374253;background:#f7f9fc;border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin-top:12px}
.instr ul{margin:4px 0 0;padding-left:18px}
.notice{border-radius:8px;padding:10px 12px;font-size:13.5px;margin-top:12px;font-weight:600}
.notice.info{background:var(--tealbg);color:#0b5f68}.notice.bad{background:#fdecea;color:#912018}
/* exam header */
.hdr{position:sticky;top:0;z-index:30;background:var(--navy);color:#fff}
.hrow{display:flex;align-items:center;gap:12px;padding:8px 12px;max-width:1280px;margin:0 auto;flex-wrap:wrap}
.htitle{flex:1;min-width:200px}.htitle b{display:block;font-size:14px}.htitle small{color:#9be4ea;font-size:11.5px}
.who{font-size:12px;color:#dbe4f3;text-align:right}.who b{color:#fff}
.timer{background:#fff;color:var(--navy);border-radius:8px;padding:5px 12px;text-align:center;line-height:1.15}
.timer small{display:block;font-size:10px;color:var(--mut);font-weight:600;letter-spacing:.8px}.timer b{font-size:19px;font-variant-numeric:tabular-nums}
.timer.low{background:#fff3d6}.timer.low b{color:#b45309}
.subs{display:flex;gap:6px;overflow-x:auto;padding:0 12px 8px;max-width:1280px;margin:0 auto}
.sbtn{flex:0 0 auto;border:1px solid rgba(255,255,255,.28);background:transparent;color:#fff;border-radius:6px;padding:6px 12px;font:600 12.5px 'Inter',sans-serif;cursor:pointer}
.sbtn.on{background:var(--teal);border-color:var(--teal)}
.sbtn i{font-style:normal;font-weight:400;opacity:.85;margin-left:5px}
/* layout */
.main{display:grid;grid-template-columns:1fr 330px;gap:12px;max-width:1280px;margin:12px auto;padding:0 12px}
.qhead{display:flex;justify-content:space-between;align-items:center;gap:8px;border-bottom:1px solid var(--line);padding-bottom:9px;margin-bottom:12px;flex-wrap:wrap}
.qhead b{color:var(--navy)}.qhead span{font-size:12.5px;color:var(--mut)}
.badge{display:inline-block;background:var(--purplebg);color:var(--purple);border:1px solid var(--purple);border-radius:20px;padding:2px 10px;font-size:11.5px;font-weight:700}
.qtext{font-size:17px;line-height:1.7;white-space:pre-line;font-weight:500;margin-bottom:14px}
.opt{display:flex;gap:12px;align-items:flex-start;border:1.5px solid var(--line);border-radius:10px;padding:12px;margin:9px 0;cursor:pointer;background:#fff;font-size:16px;line-height:1.55;white-space:pre-line}
.opt .l{flex:0 0 30px;height:30px;border-radius:50%;border:1.5px solid var(--line);color:var(--navy);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;background:#fff}
.opt:hover{border-color:#8fa9de}
.opt.sel{background:var(--bluebg);border-color:var(--blue)}.opt.sel .l{background:var(--blue);border-color:var(--blue);color:#fff}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;border-top:1px solid var(--line);padding-top:14px}
.actions .sp{flex:1}
.pal h3{margin:0 0 8px;font-size:13px;color:var(--navy)}
.psum{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:10px}
.psum div{background:#f4f6fa;border-radius:8px;padding:6px 4px;text-align:center;font-size:11px;color:var(--mut)}.psum b{display:block;font-size:15px;color:var(--navy)}
.pscroll{max-height:58vh;overflow:auto;padding-right:2px}
.ph{font-size:12px;font-weight:700;color:#fff;background:var(--navy2);border-radius:5px;padding:4px 8px;margin:10px 0 6px}
.grid{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}
.pb{position:relative;border:1.5px solid var(--line);border-radius:7px;background:#fff;padding:7px 0;font:600 12.5px 'Inter',sans-serif;cursor:pointer;color:#344}
.pb.ans{background:var(--blue);border-color:var(--blue);color:#fff}
.pb.rev{background:var(--purple);border-color:var(--purple);color:#fff}
.pb.ansrev{background:var(--blue);border-color:var(--purple);color:#fff;box-shadow:inset 0 0 0 2px var(--purple)}
.pb.ansrev:after,.pb.rev:after{content:"★";position:absolute;top:-6px;right:-3px;font-size:11px;color:var(--purple);background:#fff;border-radius:50%;line-height:12px;width:13px;height:13px}
.pb.cur{outline:3px solid var(--teal);outline-offset:1px}
.legend{display:grid;grid-template-columns:1fr 1fr;gap:5px;font-size:11.5px;margin-top:12px;color:var(--mut)}
.legend i{display:inline-block;width:14px;height:14px;border-radius:4px;vertical-align:-3px;margin-right:5px;border:1.5px solid var(--line);background:#fff}
.legend .a{background:var(--blue);border-color:var(--blue)}.legend .r{background:var(--purple);border-color:var(--purple)}.legend .ar{background:var(--blue);border-color:var(--purple);box-shadow:inset 0 0 0 2px var(--purple)}.legend .c{outline:3px solid var(--teal);outline-offset:0;border-color:var(--line)}
.pfab{display:none}
/* modal */
.modal{position:fixed;inset:0;background:rgba(8,18,38,.62);z-index:60;display:flex;align-items:center;justify-content:center;padding:14px}
.mbox{background:#fff;border-radius:12px;padding:20px;max-width:450px;width:100%;max-height:88vh;overflow:auto}
.mbox h2{margin:0 0 8px;font-size:18px;color:var(--navy)}
.mrow{display:flex;gap:10px;margin-top:16px}.mrow .btn{flex:1}
.sumt{width:100%;border-collapse:collapse;margin-top:8px;font-size:14px}.sumt td{padding:6px 4px;border-bottom:1px solid var(--line)}.sumt td:last-child{text-align:right;font-weight:700}
/* result */
.score-big{font-size:48px;font-weight:700;color:var(--navy);line-height:1.1}
.res-top{text-align:center}
.bd{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}
.bd div{background:#f4f6fa;border-radius:8px;padding:8px;font-size:12px;text-align:center;color:var(--mut)}.bd b{display:block;font-size:16px;color:var(--navy)}
.subt{width:100%;border-collapse:collapse;font-size:13px;margin:8px 0}
.subt th{background:var(--navy);color:#fff;text-align:left;padding:7px}.subt td{border-bottom:1px solid var(--line);padding:7px}
.bar{height:8px;border-radius:4px;background:#e6ebf3;overflow:hidden}.bar i{display:block;height:100%;background:var(--teal)}
.fl{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}.fl button{border:1px solid var(--line);background:#fff;border-radius:20px;padding:6px 12px;font:600 12px 'Inter',sans-serif;cursor:pointer}.fl button.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.rv{border:1px solid var(--line);border-radius:10px;padding:12px;margin:10px 0;background:#fff}
.rv .t{font-size:12px;color:var(--mut);margin-bottom:4px}
.rv .q{white-space:pre-line;font-weight:500;line-height:1.6}
.rv .st{display:inline-block;font-size:11.5px;font-weight:700;border-radius:5px;padding:2px 8px;margin-right:6px}
.st.c{background:#dff5e6;color:#14532d}.st.w{background:#fde4e1;color:#912018}.st.u{background:#eceff4;color:#475467}
.rv .a{font-size:14px;margin-top:6px;white-space:pre-line}.rv .e{margin-top:6px;background:var(--tealbg);border-radius:6px;padding:7px 9px;font-size:13px}
.lb{width:100%;border-collapse:collapse;font-size:13px}.lb th{background:var(--navy);color:#fff;padding:6px;text-align:left}.lb td{padding:6px;border-bottom:1px solid var(--line)}.lb tr.me td{background:#fff3c4;font-weight:700}
@media(max-width:920px){
 .main{grid-template-columns:1fr}
 .pal{position:fixed;left:0;right:0;bottom:0;z-index:50;border-radius:14px 14px 0 0;max-height:72vh;overflow:auto;transform:translateY(105%);transition:transform .2s;border-color:var(--navy)}
 .pal.open{transform:none}.pscroll{max-height:none}
 .pfab{display:block;position:fixed;right:12px;bottom:14px;z-index:40;background:var(--navy);color:#fff;border:0;border-radius:24px;padding:11px 16px;font:600 13px 'Inter',sans-serif;box-shadow:0 3px 10px rgba(0,0,0,.35)}
 .qtext{font-size:16px}.opt{font-size:15px}.who{display:none}body{padding-bottom:64px}
 .facts{grid-template-columns:repeat(2,1fr)}
}
/* ---- printable PDF report ---- */
#printArea{display:none}
.pr h1{font-size:17px;margin:0;color:#0b2447}.pr .sub{font-size:11px;color:#444;margin:2px 0 8px}
.pr table{width:100%;border-collapse:collapse;font-size:11px;margin:6px 0 10px}.pr th{background:#0b2447;color:#fff;text-align:left;padding:4px 6px}.pr td{border:1px solid #bbb;padding:4px 6px}
.pq{border:1px solid #bbb;border-radius:5px;padding:6px 8px;margin:6px 0;break-inside:avoid;page-break-inside:avoid;font-size:11.5px;line-height:1.45}
.pq .h{font-size:10px;color:#555;display:flex;justify-content:space-between;margin-bottom:2px}
.pq .q{white-space:pre-line;font-weight:600;margin-bottom:3px}
.pq .o{white-space:pre-line;padding:2px 5px;border-radius:3px;margin:1px 0;border:1px solid transparent}
.pq .o.ck{background:#dff5e6!important;border-color:#2e9d57}.pq .o.wr{background:#fde4e1!important;border-color:#d4483b}
.pq .tag{font-weight:700;font-size:10px;margin-left:6px}
.pq .stt{font-weight:700;font-size:10px;border-radius:3px;padding:1px 6px}
.pq .stt.c{background:#dff5e6;color:#14532d}.pq .stt.w{background:#fde4e1;color:#912018}.pq .stt.u{background:#e6e8ec;color:#333}
.pq .ex{font-size:10.5px;background:#eef5f6!important;padding:3px 5px;border-radius:3px;margin-top:3px}
.pfoot{display:none}
 #pdfStage .pg .ph1{border-bottom:3px solid #0e9aa7;padding-bottom:6px;margin-bottom:8px}
 #pdfStage .pg h1{margin:0;font-size:16pt;color:#0b2447}#pdfStage .pg h2{margin:2px 0 0;font-size:10pt;color:#0e9aa7;letter-spacing:1px}
 #pdfStage .pg .meta{font-size:10.5pt;line-height:1.55;margin:6px 0}
 #pdfStage .pg .big{font-size:15pt;font-weight:700;color:#0b2447}
 #pdfStage .pg table{width:100%;border-collapse:collapse;font-size:10pt;margin:6px 0 10px}
 #pdfStage .pg th{background:#0b2447;color:#fff;text-align:left;padding:4px 6px}#pdfStage .pg td{border-bottom:1px solid #ccd3df;padding:4px 6px}
 #pdfStage .pg .sec{font-size:12pt;font-weight:700;color:#fff;background:#19376d;padding:4px 8px;margin:12px 0 6px;break-after:avoid}
 #pdfStage .pg .pq{border:1px solid #bcc6d6;border-radius:5px;padding:7px 9px;margin:0 0 7px;break-inside:avoid;page-break-inside:avoid}
 #pdfStage .pg .pq .h{font-size:9.5pt;color:#444;margin-bottom:3px}
 #pdfStage .pg .pq .q{font-weight:600;white-space:pre-line;line-height:1.45;margin-bottom:4px}
 #pdfStage .pg .po{padding:2px 6px;margin:2px 0;border-radius:3px;white-space:pre-line;line-height:1.4;border:1px solid transparent}
 #pdfStage .pg .po.ok{background:#dff5e6;border-color:#2e9e57}
 #pdfStage .pg .po.bad{background:#fde4e1;border-color:#d23a2c}
 #pdfStage .pg .po.pick{background:#dbe7ff;border-color:#1d4ed8}
 #pdfStage .pg .tag{font-size:8.5pt;font-weight:700;margin-left:6px}
 #pdfStage .pg .stt{display:inline-block;font-size:9pt;font-weight:700;border-radius:3px;padding:1px 7px;margin-left:6px}
 #pdfStage .pg .stt.c{background:#14532d;color:#fff}#pdfStage .pg .stt.w{background:#b42318;color:#fff}#pdfStage .pg .stt.u{background:#555;color:#fff}
 #pdfStage .pg .ex{font-size:9.5pt;background:#e3f6f7;padding:3px 6px;margin-top:3px;border-radius:3px}
 #pdfStage .pg .foot{margin-top:12px;text-align:center;font-size:9pt;color:#444;border-top:1px solid #ccd3df;padding-top:6px}
#pdfStage{position:fixed;left:-12000px;top:0;width:794px;background:#fff}
#pdfStage .pg{width:794px;height:1123px;padding:38px 36px 0;background:#fff;color:#111;font-family:'Inter','Noto Sans Telugu',sans-serif;font-size:14px;position:relative;overflow:hidden}
#pdfStage .pg .pfoot{display:block;position:absolute;left:36px;right:36px;bottom:14px;text-align:center;font-size:11px;color:#444;border-top:1px solid #ccd3df;padding-top:5px}
#pdfStage .pg .pq{margin-bottom:9px}
#pdfStage .pg .po{padding:3px 7px;margin:3px 0;border-radius:3px;white-space:pre-line;line-height:1.45;border:1px solid transparent}

@media print{
 @page{size:A4;margin:12mm 11mm 16mm}
 body>*:not(#printArea){display:none!important}
 html,body{background:#fff!important}
 #printArea{display:block!important;-webkit-print-color-adjust:exact;print-color-adjust:exact;color:#111;font-family:'Inter','Noto Sans Telugu',sans-serif}
 .pfoot{display:block;position:fixed;bottom:0;left:0;right:0;text-align:center;font-size:8.5px;color:#333;border-top:1px solid #bbb;padding-top:2px}
}

/* ---- printable PDF report ---- */
#printArea{display:none}
@media print{
 @page{size:A4;margin:14mm 12mm 16mm}
 body>*:not(#printArea){display:none!important}
 html,body{background:#fff!important}
 body{padding:0!important;-webkit-user-select:text;user-select:text}
 #printArea{display:block!important;color:#111;font-size:11.5pt;-webkit-print-color-adjust:exact;print-color-adjust:exact}
 #printArea .ph1{border-bottom:3px solid #0e9aa7;padding-bottom:6px;margin-bottom:8px}
 #printArea h1{margin:0;font-size:16pt;color:#0b2447}#printArea h2{margin:2px 0 0;font-size:10pt;color:#0e9aa7;letter-spacing:1px}
 #printArea .meta{font-size:10.5pt;line-height:1.55;margin:6px 0}
 #printArea .big{font-size:15pt;font-weight:700;color:#0b2447}
 #printArea table{width:100%;border-collapse:collapse;font-size:10pt;margin:6px 0 10px}
 #printArea th{background:#0b2447;color:#fff;text-align:left;padding:4px 6px}#printArea td{border-bottom:1px solid #ccd3df;padding:4px 6px}
 #printArea .sec{font-size:12pt;font-weight:700;color:#fff;background:#19376d;padding:4px 8px;margin:12px 0 6px;break-after:avoid}
 #printArea .pq{border:1px solid #bcc6d6;border-radius:5px;padding:7px 9px;margin:0 0 7px;break-inside:avoid;page-break-inside:avoid}
 #printArea .pq .h{font-size:9.5pt;color:#444;margin-bottom:3px}
 #printArea .pq .q{font-weight:600;white-space:pre-line;line-height:1.45;margin-bottom:4px}
 #printArea .po{padding:2px 6px;margin:2px 0;border-radius:3px;white-space:pre-line;line-height:1.4;border:1px solid transparent}
 #printArea .po.ok{background:#dff5e6;border-color:#2e9e57}
 #printArea .po.bad{background:#fde4e1;border-color:#d23a2c}
 #printArea .po.pick{background:#dbe7ff;border-color:#1d4ed8}
 #printArea .tag{font-size:8.5pt;font-weight:700;margin-left:6px}
 #printArea .stt{display:inline-block;font-size:9pt;font-weight:700;border-radius:3px;padding:1px 7px;margin-left:6px}
 #printArea .stt.c{background:#14532d;color:#fff}#printArea .stt.w{background:#b42318;color:#fff}#printArea .stt.u{background:#555;color:#fff}
 #printArea .ex{font-size:9.5pt;background:#e3f6f7;padding:3px 6px;margin-top:3px;border-radius:3px}
 #printArea .foot{margin-top:12px;text-align:center;font-size:9pt;color:#444;border-top:1px solid #ccd3df;padding-top:6px}
}
</style>
</head>
<body class="noselect">

<!-- ================= START ================= -->
<div id="start" class="wrap">
 <div class="hero"><h1 id="hTitle"></h1><h2>MATHEMATICS AND SCIENCES</h2><p>Test ID: <b id="hId"></b></p></div>
 <div class="card" style="margin-top:12px">
  <div class="facts"><div><b>150</b>Questions</div><div><b>150</b>Marks</div><div><b id="fDur">150</b>Minutes</div><div><b>No</b>Negative marking</div></div>
  <div class="notice info" id="sched"></div>
  <label for="nm">Candidate Name *</label>
  <input type="text" id="nm" maxlength="40" placeholder="Enter your full name" autocomplete="off">
  <label for="ds">District *</label>
  <input type="text" id="ds" maxlength="30" placeholder="Enter your district" autocomplete="off">
  <div class="err" id="serr"></div>
  <button class="btn navy" style="width:100%;padding:14px;font-size:16px" id="go">Start Examination</button>
  <button class="btn sec" style="width:100%;margin-top:10px" id="lbStart">Leaderboard</button>
  <div class="instr"><b>Instructions</b><ul>
   <li>CDP 30 • Telugu 30 • English 30 • Mathematics 20 • Physical Science 20 • Biological Science 20.</li>
   <li>You may change an answer or use <b>Clear Response</b> at any time before final submission. Answers and the correct key are shown only after you submit.</li>
   <li>Use <b>Mark for Review</b> to flag a question; it does not lock your answer.</li>
   <li>The timer starts when you begin and continues if you refresh the page. The test submits automatically when time ends.</li>
   <li>This test can be attempted <b>only once</b> per candidate.</li></ul></div>
 </div>
 <div class="credit"><b>C.RASOOL BAVAJI, S.A.(P.S.), ZPHS, MADANAPALLE, ANNAMAYYA DISTRICT</b><br><a href="https://tenthquiz.blogspot.com" target="_blank" rel="noopener">https://tenthquiz.blogspot.com</a></div>
</div>

<!-- ================= EXAM ================= -->
<div id="exam" class="hidden">
 <div class="hdr">
  <div class="hrow">
   <div class="htitle"><b id="eTitle"></b><small id="eSub"></small></div>
   <div class="who" id="eWho"></div>
   <div class="timer" id="tbox"><small>TIME LEFT</small><b id="tm">--:--:--</b></div>
   <button class="btn warn" id="subBtn">Submit Examination</button>
  </div>
  <div class="subs" id="subs"></div>
 </div>
 <div class="main">
  <div class="card">
   <div class="qhead"><div><b id="qno"></b> <span id="qsub"></span></div><div><span id="qmk">1 mark</span> <span class="badge hidden" id="qrev">★ Marked for review</span></div></div>
   <div class="qtext" id="qt"></div>
   <div id="opts"></div>
   <div class="actions">
    <button class="btn rev" id="mark">Mark for Review</button>
    <button class="btn sec" id="clr">Clear Response</button>
    <span class="sp"></span>
    <button class="btn sec" id="prev">◀ Previous</button>
    <button class="btn" id="next">Next ▶</button>
   </div>
  </div>
  <div class="card pal" id="pal">
   <h3>Question Palette</h3>
   <div class="psum"><div><b id="cA">0</b>Answered</div><div><b id="cU">150</b>Not answered</div><div><b id="cR">0</b>Marked</div></div>
   <div class="pscroll" id="pscroll"></div>
